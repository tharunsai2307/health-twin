# HealthTwin Backend Environment Variables (Example)
ENVIRONMENT=production
DATABASE_URL=sqlite:///./healthtwin.db
# REQUIRED: Generate a strong secret key for JWT signing
JWT_SECRET=generate-a-secure-random-key-here
# REQUIRED: Restrict CORS to your frontend domain in production
CORS_ORIGINS=https://your-frontend-domain.com
# SET TO false IN PRODUCTION
CREATE_DEMO_ADMIN=false
# Optional API Key for medical document OCR
GEMINI_API_KEY=your-gemini-api-key-here
